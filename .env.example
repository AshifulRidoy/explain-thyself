# Postgres (docker compose up)
DATABASE_URL=postgresql://ets:ets@localhost:5432/explain_the_self

# Trace engine
NEXT_PUBLIC_ENGINE_URL=http://localhost:8000
ETS_MODEL=gpt2-small
# auto | mps | cpu
ETS_DEVICE=auto
ETS_CORS_ORIGINS=http://localhost:3000
# off skips the ~2s CPU numerics self-check at model load
ETS_SELF_CHECK=on
